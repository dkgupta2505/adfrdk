{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "sourcestg"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "dimemployee",
					"description": "select * from [dd].[dim_employee_new] where active_status='Y'"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "sink2"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "sink3"
				}
			],
			"transformations": [
				{
					"name": "lookup1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> sourcestg",
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from [dd].[dim_employee_new] where active_status=\\'Y\\'',",
				"     format: 'query') ~> dimemployee",
				"sourcestg, dimemployee lookup(sourcestg@Emp_ID == dimemployee@Emp_ID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 split(isNull(dimemployee@Emp_ID),",
				"     disjoint: false) ~> split1@(newrecords, udpaterecords)",
				"split1@newrecords derive(EffectiveFrom = currentDate(),",
				"          EffectTo = '1999-01-01',",
				"          active_status = 'Y',",
				"          LoadDt = currentDate()) ~> derivedColumn1",
				"select1 derive(Sql_ModifiedDt = currentDate(),",
				"          Sql_UpdatedBy = 'Deepika',",
				"          Sql_active_status = 'N') ~> derivedColumn2",
				"derivedColumn2 alterRow(updateIf(true())) ~> alterRow1",
				"split1@udpaterecords select(mapColumn(",
				"          Sql_Emp_ID = split1@udpaterecords@Emp_ID,",
				"          Sql_First_Name = split1@udpaterecords@First_Name,",
				"          Sql_Gender = split1@udpaterecords@Gender,",
				"          Sql_Start_Date = split1@udpaterecords@Start_Date,",
				"          Sql_Salary = split1@udpaterecords@Salary,",
				"          Sql_Bonus = split1@udpaterecords@Bonus,",
				"          Sql_Team = split1@udpaterecords@Team,",
				"          Sql_Mob_No = split1@udpaterecords@Mob_No,",
				"          Sql_Country = split1@udpaterecords@Country,",
				"          Sql_City = split1@udpaterecords@City,",
				"          Sql_State = split1@udpaterecords@State,",
				"          Sql_Postal_Code = split1@udpaterecords@Postal_Code,",
				"          Sql_Region = split1@udpaterecords@Region,",
				"          Sql_Band = split1@udpaterecords@Band,",
				"          Sql_active_status = split1@udpaterecords@active_status,",
				"          Sql_BaseLocation = split1@udpaterecords@BaseLocation,",
				"          Sql_EffectiveFrom = split1@udpaterecords@EffectiveFrom,",
				"          Sql_EffectTo = split1@udpaterecords@EffectTo,",
				"          Sql_LoadDt = split1@udpaterecords@LoadDt,",
				"          Sql_ModifiedDt = split1@udpaterecords@ModifiedDt,",
				"          Sql_UpdatedBy = split1@udpaterecords@UpdatedBy",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> select1",
				"select1 derive(Sql_ModifiedDt = currentDate(),",
				"          Sql_UpdatedBy = 'Deepika') ~> derivedColumn3",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sink1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['Emp_ID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ModifiedDt = Sql_ModifiedDt,",
				"          Emp_ID = Sql_Emp_ID,",
				"          UpdatedBy = Sql_UpdatedBy,",
				"          active_status = Sql_active_status",
				"     )) ~> sink2",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_ID = Sql_Emp_ID,",
				"          First_Name = Sql_First_Name,",
				"          Gender = Sql_Gender,",
				"          Start_Date = Sql_Start_Date,",
				"          Salary = Sql_Salary,",
				"          Bonus = Sql_Bonus,",
				"          Team = Sql_Team,",
				"          Mob_No = Sql_Mob_No,",
				"          Country = Sql_Country,",
				"          City = Sql_City,",
				"          State = Sql_State,",
				"          Postal_Code = Sql_Postal_Code,",
				"          Region = Sql_Region,",
				"          Band = Sql_Band,",
				"          active_status = Sql_active_status,",
				"          BaseLocation = Sql_BaseLocation,",
				"          EffectiveFrom = Sql_EffectiveFrom,",
				"          EffectTo = Sql_EffectTo,",
				"          LoadDt = Sql_LoadDt,",
				"          ModifiedDt = Sql_ModifiedDt,",
				"          UpdatedBy = Sql_UpdatedBy",
				"     )) ~> sink3"
			]
		}
	}
}
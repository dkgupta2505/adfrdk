{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_az_sql_server_2026",
						"type": "DatasetReference"
					},
					"name": "staging"
				},
				{
					"dataset": {
						"referenceName": "ds_target_sql_2026",
						"type": "DatasetReference"
					},
					"name": "target"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_az_sql_target_2026",
						"type": "DatasetReference"
					},
					"name": "targetsink"
				}
			],
			"transformations": [
				{
					"name": "lookup1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as string,",
				"          BaseLocation as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> staging",
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'select * from [dd].[dim_employee] where active_status=\\'Y\\'',",
				"     format: 'query') ~> target",
				"staging, target lookup(staging@Emp_ID == target@Emp_ID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 split(isNull(staging@Emp_ID),",
				"     disjoint: false) ~> split1@(newrows, existing)",
				"split1@newrows derive(EffectiveFrom = currentDate(),",
				"          EffectiveTo = \"1999-01-01\",",
				"          LoadDt = currentDate()) ~> derivedColumn1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as string,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_ID = split1@Emp_ID,",
				"          First_Name = split1@First_Name,",
				"          Gender = split1@Gender,",
				"          Start_Date = split1@Start_Date,",
				"          Salary = split1@Salary,",
				"          Bonus = split1@Bonus,",
				"          Team = split1@Team,",
				"          Mob_No = split1@Mob_No,",
				"          Country = split1@Country,",
				"          City = split1@City,",
				"          State = split1@State,",
				"          Postal_Code = split1@Postal_Code,",
				"          Region = split1@Region,",
				"          Band = split1@Band,",
				"          active_status = split1@active_status,",
				"          BaseLocation = split1@BaseLocation,",
				"          EffectiveFrom = derivedColumn1@EffectiveFrom,",
				"          EffectTo,",
				"          LoadDt,",
				"          ModifiedDt,",
				"          UpdatedBy",
				"     )) ~> targetsink"
			]
		}
	}
}
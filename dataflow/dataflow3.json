{
	"name": "dataflow3",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "stgsource"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "targetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "exists1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> stgsource",
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> targetsource",
				"stgsource select(mapColumn(",
				"          Sql_Emp_ID = Emp_ID,",
				"          Sql_First_Name = First_Name,",
				"          Sql_Gender = Gender,",
				"          Sql_Start_Date = Start_Date,",
				"          Sql_Salary = Salary,",
				"          Sql_Bonus = Bonus,",
				"          Sql_Team = Team,",
				"          Sql_Mob_No = Mob_No,",
				"          Sql_Country = Country,",
				"          Sql_City = City,",
				"          Sql_State = State,",
				"          Sql_Postal_Code = Postal_Code,",
				"          Sql_Region = Region,",
				"          Sql_Band = Band,",
				"          Sql_active_status = active_status,",
				"          Sql_BaseLocation = BaseLocation,",
				"          Sql_EffectiveFrom = EffectiveFrom,",
				"          Sql_EffectTo = EffectTo,",
				"          Sql_LoadDt = LoadDt,",
				"          Sql_ModifiedDt = ModifiedDt,",
				"          Sql_UpdatedBy = UpdatedBy",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, targetsource lookup(Sql_Emp_ID == Emp_ID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 split(isNull(Emp_ID),",
				"     disjoint: true) ~> split1@(Insertrows, Update)",
				"split1@Insertrows derive(Sql_active_status = \"Y\",",
				"          Sql_LoadDt = currentDate()) ~> derivedColumn1",
				"split1@Update, targetsource exists(Sql_First_Name!=split1@Update@First_Name || Sql_Mob_No!=split1@Update@Mob_No ,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_ID = Sql_Emp_ID,",
				"          First_Name = Sql_First_Name,",
				"          Gender = Sql_Gender,",
				"          Start_Date = Sql_Start_Date,",
				"          Salary = Sql_Salary,",
				"          Bonus = Sql_Bonus,",
				"          Team = Sql_Team,",
				"          Mob_No = Sql_Mob_No,",
				"          Country = Sql_Country,",
				"          City = Sql_City,",
				"          State = Sql_State,",
				"          Postal_Code = Sql_Postal_Code,",
				"          Region = Sql_Region,",
				"          Band = Sql_Band,",
				"          active_status = Sql_active_status,",
				"          BaseLocation = Sql_BaseLocation,",
				"          EffectiveFrom = Sql_EffectiveFrom,",
				"          EffectTo = Sql_EffectTo,",
				"          LoadDt = Sql_LoadDt,",
				"          ModifiedDt = Sql_ModifiedDt,",
				"          UpdatedBy = Sql_UpdatedBy",
				"     )) ~> sink1"
			]
		}
	}
}
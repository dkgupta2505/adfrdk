{
	"name": "dataflow3",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "stgsource"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "targetsource"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "sink1"
				},
				{
					"dataset": {
						"referenceName": "AzureSqlTableTargetDeepika",
						"type": "DatasetReference"
					},
					"name": "sink2"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "lookup1"
				},
				{
					"name": "split1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "alterRow1"
				},
				{
					"name": "select2"
				},
				{
					"name": "exists2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "select3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> stgsource",
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> targetsource",
				"stgsource select(mapColumn(",
				"          Sql_Emp_ID = Emp_ID,",
				"          Sql_First_Name = First_Name,",
				"          Sql_Gender = Gender,",
				"          Sql_Start_Date = Start_Date,",
				"          Sql_Salary = Salary,",
				"          Sql_Bonus = Bonus,",
				"          Sql_Team = Team,",
				"          Sql_Mob_No = Mob_No,",
				"          Sql_Country = Country,",
				"          Sql_City = City,",
				"          Sql_State = State,",
				"          Sql_Postal_Code = Postal_Code,",
				"          Sql_Region = Region,",
				"          Sql_Band = Band,",
				"          Sql_BaseLocation = BaseLocation",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, targetsource lookup(Sql_Emp_ID == Emp_ID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 split(isNull(Emp_ID),",
				"     disjoint: true) ~> split1@(Insertrows, Update)",
				"split1@Insertrows derive(Sql_active_Status = \"Y\",",
				"          Sql_loaddt = currentDate(),",
				"          Sql_Effectivedt = currentDate(),",
				"          Sql_effectto = \"1999-01-01\") ~> derivedColumn1",
				"split1@Update, targetsource exists(Sql_First_Name!=split1@Update@First_Name || Sql_Mob_No!=split1@Update@Mob_No,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 derive(Sql_Active_Status = \"N\",",
				"          Sql_ModifiedDate = currentDate(),",
				"          Sql_UpdateBy = \"Deepika\") ~> derivedColumn2",
				"select2 alterRow(updateIf(true())) ~> alterRow1",
				"derivedColumn2 select(mapColumn(",
				"          Emp_ID,",
				"          First_Name,",
				"          Gender,",
				"          Start_Date,",
				"          Salary,",
				"          Bonus,",
				"          Team,",
				"          Mob_No,",
				"          Country,",
				"          City,",
				"          State,",
				"          Postal_Code,",
				"          Region,",
				"          Band,",
				"          active_status,",
				"          BaseLocation,",
				"          EffectiveFrom,",
				"          EffectTo,",
				"          LoadDt,",
				"          ModifiedDt,",
				"          UpdatedBy,",
				"          Sql_Active_Status,",
				"          Sql_ModifiedDate,",
				"          Sql_UpdateBy",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select2",
				"split1@Update, targetsource exists(Sql_First_Name!=split1@Update@First_Name || Sql_Mob_No!=split1@Update@Mob_No,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists2",
				"exists2 derive(Sql_Active_Status = \"Y\",",
				"          Sql_LoadDate = currentDate()) ~> derivedColumn3",
				"derivedColumn3 select(mapColumn(",
				"          Sql_Emp_ID,",
				"          Sql_First_Name,",
				"          Sql_Gender,",
				"          Sql_Start_Date,",
				"          Sql_Salary,",
				"          Sql_Bonus,",
				"          Sql_Team,",
				"          Sql_Mob_No,",
				"          Sql_Country,",
				"          Sql_City,",
				"          Sql_State,",
				"          Sql_Postal_Code,",
				"          Sql_Region,",
				"          Sql_Band,",
				"          Sql_BaseLocation,",
				"          UpdatedBy,",
				"          Sql_Active_Status,",
				"          Sql_LoadDate",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select3",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_ID = Sql_Emp_ID,",
				"          First_Name = Sql_First_Name,",
				"          Gender = Sql_Gender,",
				"          Start_Date = Sql_Start_Date,",
				"          Salary = Sql_Salary,",
				"          Bonus = Sql_Bonus,",
				"          Team = Sql_Team,",
				"          Mob_No = Sql_Mob_No,",
				"          Country = Sql_Country,",
				"          City = Sql_City,",
				"          State = Sql_State,",
				"          Postal_Code = Sql_Postal_Code,",
				"          Region = Sql_Region,",
				"          Band = Sql_Band,",
				"          active_status = Sql_active_Status,",
				"          BaseLocation = Sql_BaseLocation,",
				"          EffectiveFrom = Sql_Effectivedt,",
				"          EffectTo = Sql_effectto,",
				"          LoadDt = Sql_loaddt,",
				"          ModifiedDt,",
				"          UpdatedBy",
				"     )) ~> sink1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['Emp_ID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_ID,",
				"          First_Name,",
				"          Gender,",
				"          Start_Date,",
				"          Salary,",
				"          Bonus,",
				"          Team,",
				"          Mob_No,",
				"          Country,",
				"          City,",
				"          State,",
				"          Postal_Code,",
				"          Region,",
				"          Band,",
				"          active_status = Sql_Active_Status,",
				"          BaseLocation,",
				"          EffectiveFrom,",
				"          EffectTo,",
				"          LoadDt,",
				"          ModifiedDt = Sql_ModifiedDate,",
				"          UpdatedBy = Sql_UpdateBy",
				"     )) ~> sink2"
			]
		}
	}
}
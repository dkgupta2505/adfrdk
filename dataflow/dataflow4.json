			"scriptLines": [
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> stgsource",
				"source(output(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> Dimsource",
				"stgsource select(mapColumn(",
				"          Sql_Emp_ID = Emp_ID,",
				"          Sql_First_Name = First_Name,",
				"          Sql_Gender = Gender,",
				"          Sql_Start_Date = Start_Date,",
				"          Sql_Salary = Salary,",
				"          Sql_Bonus = Bonus,",
				"          Sql_Team = Team,",
				"          Sql_Mob_No = Mob_No,",
				"          Sql_Country = Country,",
				"          Sql_City = City,",
				"          Sql_State = State,",
				"          Sql_Postal_Code = Postal_Code,",
				"          Sql_Region = Region,",
				"          Sql_Band = Band,",
				"          Sql_BaseLocation = BaseLocation",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1, Dimsource lookup(Sql_Emp_ID == Emp_ID,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lookup1",
				"lookup1 split(isNull(Emp_ID),",
				"     disjoint: false) ~> split1@(Insertrow, Updaterows)",
				"split1@Insertrow derive(Sql_Active_Status = \"Y\",",
				"          Sql_Loaddate = currentDate(),",
				"          Sql_EffectiveDate = currentDate(),",
				"          Sql_EffectTo = \"1999-01-01\") ~> derivedColumn1",
				"split1@Updaterows, Dimsource exists(Sql_First_Name!=Dimsource@First_Name || Sql_Mob_No!=Dimsource@Mob_No,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"exists1 derive(Dev_Active_status = \"N\",",
				"          Dev_Modifieddate = currentDate(),",
				"          Dev_Updatedby = \"DeepikaR\") ~> derivedColumn2",
				"derivedColumn2 alterRow(updateIf(true())) ~> alterRow1",
				"split1@Updaterows, Dimsource exists(Sql_First_Name!=Dimsource@First_Name || Sql_Mob_No!=Dimsource@Mob_No,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists2",
				"exists2 derive(Dev_Active_Status = \"Y\",",
				"          Dev_loaddate = currentDate(),",
				"          Dev_EffectiveDate = currentDate(),",
				"          Dev_Effectto = \"1999-01-01\") ~> derivedColumn3",
				"derivedColumn1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_ID = Sql_Emp_ID,",
				"          First_Name = Sql_First_Name,",
				"          Gender = Sql_Gender,",
				"          Start_Date = Sql_Start_Date,",
				"          Salary = Sql_Salary,",
				"          Bonus = Sql_Bonus,",
				"          Team = Sql_Team,",
				"          Mob_No = Sql_Mob_No,",
				"          Country = Sql_Country,",
				"          City = Sql_City,",
				"          State = Sql_State,",
				"          Postal_Code = Sql_Postal_Code,",
				"          Region = Sql_Region,",
				"          Band = Sql_Band,",
				"          active_status = Sql_Active_Status,",
				"          BaseLocation = Sql_BaseLocation,",
				"          EffectiveFrom = Sql_EffectiveDate,",
				"          EffectTo = Sql_EffectTo,",
				"          LoadDt = Sql_Loaddate,",
				"          ModifiedDt,",
				"          UpdatedBy",
				"     )) ~> sink1",
				"alterRow1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:true,",
				"     upsertable:false,",
				"     keys:['Emp_ID'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_ID,",
				"          First_Name,",
				"          Gender,",
				"          Start_Date,",
				"          Salary,",
				"          Bonus,",
				"          Team,",
				"          Mob_No,",
				"          Country,",
				"          City,",
				"          State,",
				"          Postal_Code,",
				"          Region,",
				"          Band,",
				"          active_status = Dev_Active_status,",
				"          BaseLocation,",
				"          EffectiveFrom,",
				"          EffectTo,",
				"          LoadDt,",
				"          ModifiedDt = Dev_Modifieddate,",
				"          UpdatedBy = Dev_Updatedby",
				"     )) ~> sink2",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          Emp_ID as string,",
				"          First_Name as string,",
				"          Gender as string,",
				"          Start_Date as date,",
				"          Salary as integer,",
				"          Bonus as double,",
				"          Team as string,",
				"          Mob_No as integer,",
				"          Country as string,",
				"          City as string,",
				"          State as string,",
				"          Postal_Code as integer,",
				"          Region as string,",
				"          Band as integer,",
				"          active_status as boolean,",
				"          BaseLocation as string,",
				"          EffectiveFrom as date,",
				"          EffectTo as date,",
				"          LoadDt as date,",
				"          ModifiedDt as date,",
				"          UpdatedBy as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          Emp_ID = Sql_Emp_ID,",
				"          First_Name = Sql_First_Name,",
				"          Gender = Sql_Gender,",
				"          Start_Date = Sql_Start_Date,",
				"          Salary = Sql_Salary,",
				"          Bonus = Sql_Bonus,",
				"          Team = Sql_Team,",
				"          Mob_No = Sql_Mob_No,",
				"          Country = Sql_Country,",
				"          City = Sql_City,",
				"          State = Sql_State,",
				"          Postal_Code = Sql_Postal_Code,",
				"          Region = Sql_Region,",
				"          Band = Sql_Band,",
				"          active_status = Dev_Active_Status,",
				"          BaseLocation = Sql_BaseLocation,",
				"          EffectiveFrom = Dev_EffectiveDate,",
				"          EffectTo = Dev_Effectto,",
				"          LoadDt = Dev_loaddate,",
				"          ModifiedDt,",
				"          UpdatedBy",
				"     )) ~> sink3"
			]
		}
